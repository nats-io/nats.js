{
  "name": "@nats-io/obj",
  "version": "3.5.0-0",
  "files": [
    "lib/",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "types": "./lib/mod.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/mod.d.ts",
        "default": "./lib/esm/mod.js"
      },
      "require": {
        "types": "./lib/mod.d.ts",
        "default": "./lib/mod.js"
      }
    },
    "./internal": {
      "import": {
        "types": "./lib/esm/internal_mod.d.ts",
        "default": "./lib/esm/internal_mod.js"
      },
      "require": {
        "types": "./lib/internal_mod.d.ts",
        "default": "./lib/internal_mod.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "internal": [
        "./lib/internal_mod.d.ts"
      ]
    }
  },
  "engines": {
    "node": ">= 22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nats-io/nats.js.git"
  },
  "private": false,
  "scripts": {
    "real-clean": "npm run clean && shx rm -Rf ./node_modules",
    "clean": "shx rm -Rf ./build ./lib",
    "build-cjs": "npm run clean && tsc",
    "build": "npm run build-cjs && npm run build-esm",
    "prepack": "npm run build",
    "bump-qualifier": "npm version prerelease --no-commit-hooks --no-git-tag-version",
    "bump-release": "npm version patch --no-commit-hooks --no-git-tag-version",
    "build-esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('lib/esm/package.json', JSON.stringify({type: 'module', sideEffects: false}) + '\\n')\""
  },
  "keywords": [],
  "author": {
    "name": "The NATS Authors"
  },
  "description": "obj library - this library implements all the base functionality for NATS objectstore for javascript clients",
  "dependencies": {
    "@nats-io/jetstream": "3.5.0-0",
    "@nats-io/nats-core": "3.5.0-0",
    "js-sha256": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "shx": "^0.4.0",
    "typescript": "^5.9.2"
  }
}
