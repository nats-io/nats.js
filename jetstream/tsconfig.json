{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "outDir": "./lib/",
    "moduleResolution": "nodenext",
    "sourceMap": true,
    "declaration": true,
    "allowJs": true,
    "removeComments": false,
    "rootDir": "./src",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "./src/**/*"
  ]
}
